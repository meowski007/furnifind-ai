# FurniFind AI Environment Configuration (Template)
# Copy to .env and adjust as needed

# Application
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database
# Local development default uses SQLite; production can use PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./furnifind.db

# Vector & AI Search Settings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
VISION_MODEL_NAME=clip-ViT-B-32
USE_LOCAL_EMBEDDINGS=True
INDEX_CACHE_DIR=./.cache

# Optional External LLM Integration (OpenAI or Gemini API compatible)
# Leave blank to use built-in deterministic query & fallback assistant
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# CORS Settings
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
